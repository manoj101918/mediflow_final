# Copy to backend/.env and fill in. NEVER commit .env or expose these values to the frontend.
ENV=dev
LOG_LEVEL=INFO

# Supabase Postgres. Dashboard -> Connect. Either:
#   - Session pooler (port 5432, works on IPv4 networks), or
#   - Direct connection db.<project-ref>.supabase.co:5432 (needs IPv6).
# Replace the scheme with postgresql+asyncpg:// and URL-encode special characters in the
# password (@ -> %40, : -> %3A, / -> %2F, # -> %23, % -> %25).
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://<project-ref>.supabase.co
# Service role key: server-side only (used to create staff auth users).
SUPABASE_SERVICE_ROLE_KEY=
# Only needed if your project still uses the legacy HS256 JWT secret.
SUPABASE_JWT_SECRET=

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

CLINIC_TIMEZONE=Asia/Kolkata

# Shared secret for POST /api/bookings/inbound (X-API-Key header). Use a long random value.
INBOUND_API_KEY=change-me-to-a-long-random-string
# Clinic that inbound bot bookings are created in.
INBOUND_CLINIC_ID=11111111-1111-4111-8111-111111111111
INBOUND_RATE_LIMIT=30/minute

# Tests: database used by pytest (seed data is never modified; tests use throwaway clinics).
TEST_DATABASE_URL=

# Dev seed password for backend/scripts/seed_users.py
SEED_PASSWORD=Clinic@12345
