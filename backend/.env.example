# Copy to backend/.env and fill in. NEVER commit .env or expose these values to the frontend.
ENV=dev
LOG_LEVEL=INFO

# Supabase Postgres. Dashboard -> Connect. Either:
#   - Session pooler (port 5432, works on IPv4 networks), or
#   - Direct connection db.<project-ref>.supabase.co:5432 (needs IPv6).
# Replace the scheme with postgresql+asyncpg:// and URL-encode special characters in the
# password (@ -> %40, : -> %3A, / -> %2F, # -> %23, % -> %25).
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://<project-ref>.supabase.co
# Service role key: server-side only (used to create staff auth users).
SUPABASE_SERVICE_ROLE_KEY=
# Only needed if your project still uses the legacy HS256 JWT secret.
SUPABASE_JWT_SECRET=

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

CLINIC_TIMEZONE=Asia/Kolkata

# Shared secret for POST /api/bookings/inbound (X-API-Key header). Use a long random value.
INBOUND_API_KEY=change-me-to-a-long-random-string
# Clinic that inbound bot bookings are created in.
INBOUND_CLINIC_ID=11111111-1111-4111-8111-111111111111
INBOUND_RATE_LIMIT=30/minute

# Tests: database used by pytest (seed data is never modified; tests use throwaway clinics).
TEST_DATABASE_URL=

# Dev seed password for backend/scripts/seed_users.py
SEED_PASSWORD=Clinic@12345

# ---------------------------------------------------------------------------
# Patient-record chatbot (RAG). Server-side only.
# ---------------------------------------------------------------------------
# Groq (chat model). Free tier: openai/gpt-oss-120b = 30 req/min, 8K tokens/min, 200K tokens/day.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=1024
# Voyage AI (embeddings). EMBEDDING_DIM must match the vector(1024) column.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIM=1024
# Client-side pacing of embedding requests (Voyage free tier: 3 per minute). 0 = no limit.
EMBEDDING_REQUESTS_PER_MINUTE=3
RAG_TOP_K=6
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_MAX_HISTORY_TURNS=4
# true = deterministic fake chat model + fake embeddings (tests / E2E, no API keys needed).
RAG_FAKE_LLM=false
# Per signed-in user.
CHAT_RATE_LIMIT=6/minute

# Report uploads (PDF / JPEG / PNG). Must match the patient-reports bucket's file size limit.
REPORT_MAX_MB=10
# PDFs with fewer extracted characters per page on average are treated as scanned (not searchable).
MIN_TEXT_CHARS_PER_PAGE=50
SIGNED_URL_TTL_SECONDS=60

# Ingestion worker (runs inside the API process).
INGESTION_WORKER_ENABLED=true
INGESTION_MAX_ATTEMPTS=5

# --- Phase 4: WhatsApp booking bot (direct Meta Cloud API, no BSP) ---
# Webhook URL to give Meta: ${PUBLIC_BASE_URL}/api/whatsapp/webhook
# The bot books into INBOUND_CLINIC_ID (set above).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# Permanent System User token (Business settings > System users), not the 24 h test token.
WHATSAPP_ACCESS_TOKEN=
# App settings > Basic > App secret (verifies X-Hub-Signature-256).
WHATSAPP_APP_SECRET=
# Any random string; type the same one into Meta's webhook form.
WHATSAPP_VERIFY_TOKEN=
# Empty = PyWa's default Graph API version.
WHATSAPP_API_VERSION=
# Paid template messages. Keep false: outside the 24 h window nothing is sent.
WHATSAPP_ALLOW_PAID_TEMPLATES=false
# true = record outbound messages instead of calling Meta (E2E / demos without WhatsApp).
WHATSAPP_FAKE=false
# Public HTTPS URL of this API (ngrok static domain), for the setup guide and admin page.
PUBLIC_BASE_URL=

BOT_WORKER_ENABLED=true
# Meta's free service messages per business number per month (since 2026-10-01).
BOT_FREE_REPLY_LIMIT=1000
# Part of the allowance kept for confirmations, emergencies, opt-out and handoff messages.
BOT_ESSENTIAL_RESERVE=100
# Understand free text / voice notes with the Groq LLM (free tier; uses GROQ_API_KEY).
BOT_LLM_ENABLED=false
BOT_NOTICE_VERSION=2026-10-v1

# Speech: STT for voice notes and the simulator (sarvam | groq | fake), TTS (browser | sarvam | fake).
# Sarvam gives signup credits (finite); Groq Whisper is the free fallback; browser TTS is free.
STT_PROVIDER=sarvam
TTS_PROVIDER=browser
SARVAM_API_KEY=
